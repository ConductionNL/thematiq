{
	"name": "thematiq",
	"version": "0.1.0",
	"description": "Thematiq — NL Design System Theme for Nextcloud",
	"engines": {
		"node": "^22.14 || ^24 || >=26",
		"npm": "^11.0.0"
	},
	"keywords": [
		"nextcloud",
		"nl-design-system",
		"rijkshuisstijl",
		"dutch-government",
		"design-tokens",
		"theming"
	],
	"homepage": "https://github.com/ConductionNL/thematiq",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/ConductionNL/thematiq.git"
	},
	"scripts": {
		"test:l10n": "L10N_SRC_DIR=js node tests/l10n/check-l10n.js",
		"test:l10n:write": "L10N_SRC_DIR=js node tests/l10n/check-l10n.js --write",
		"test:l10n:completeness": "node tests/l10n/check-l10n-completeness.js",
		"test:l10n:completeness:write": "node tests/l10n/check-l10n-completeness.js --write",
		"generate:lasuite-tokens": "node scripts/generate-lasuite-tokens.mjs",
		"test:lasuite-tokens": "node scripts/generate-lasuite-tokens.mjs --check",
		"generate:lasuite-override": "node scripts/generate-lasuite-tokens.mjs --override",
		"test:lasuite-override": "node scripts/generate-lasuite-tokens.mjs --override --check",
		"test:lasuite-bridge-coverage": "node tests/css/check-lasuite-bridge-coverage.js",
		"build": "npm run build:fonts && npm run build:fonts:marianne && npm run build:icons",
		"build:fonts": "node scripts/build-fonts.js",
		"build:fonts:marianne": "node scripts/build-fonts-marianne.js",
		"build:icons": "node scripts/build-icons.js",
		"lint": "echo 'No JavaScript to lint - thematiq is CSS/PHP only'",
		"stylelint": "stylelint \"css/**/*.{css,scss}\"",
		"stylelint:fix": "stylelint \"css/**/*.{css,scss}\" --fix",
		"test": "echo 'No tests yet'",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=js/** --coverage.reportsDirectory=coverage-vitest",
		"test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
		"test:unit:watch": "vitest",
		"check:manifest": "node tests/validate-manifest.js",
		"format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
		"format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
		"prepare": "git config core.hooksPath .githooks || true",
		"l10n:build": "node scripts/build-l10n-js.js",
		"check:l10n-js": "node scripts/build-l10n-js.js --check"
	},
	"dependencies": {
		"@fontsource/fira-sans": "^5.0.0"
	},
	"optionalDependencies": {
		"@gouvfr/dsfr": "^1.15.1"
	},
	"devDependencies": {
		"@conduction/nextcloud-vue": "^2.25.1",
		"@cyclonedx/cyclonedx-npm": "^6.0.1",
		"@nextcloud/prettier-config": "^1.2.0",
		"@openfun/cunningham-tokens": "^3.0.0",
		"@playwright/test": "^1.63.0",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"prettier": "@nextcloud/prettier-config"
}
