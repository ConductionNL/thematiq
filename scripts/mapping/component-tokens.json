					"callout": 1
				},
				"--nldesign-component-header-color": {
					"global": "--color-primary-text",
					"label": "Header glyphs",
					"type": "color",
					"primary": true,
					"paints": "App icons, search and the account glyphs",
					"callout": 1
				},
				"--nldesign-component-header-hover-background-color": {
					"global": "--color-background-hover",
					"label": "Header hovered entry",
					"type": "color",
					"primary": false,
					"paints": "Hovered app entry",
					"callout": 2
				}
			}
		},
