{
	"_comment": [
		"The Den Haag component properties a portal reads, and where each value comes from.",
		"Read by scripts/generate-denhaag-bridge.mjs, which writes the generated section of",
		"css/public-bridge.css. openspec/changes/denhaag-component-tokens, design D1 and D2.",
		"",
		"colours: every colour property maps to a --nldesign-* semantic token; its literal fallback",
		"is read from css/systems/nldesign/defaults.css, so the fallback never drifts from the defaults.",
		"explicit: geometry the pinned tokens package does not define, with the Den Haag scale step chosen.",
		"aliases: an older property name that reads the newer one.",
		"Everything else is copied from @gemeente-denhaag/design-tokens-components, resolved to literals.",
		"derived: tokens the bridge computes from the set, e.g. darker status text; a set may declare its own to override."
	],
	"sources": {
		"components": {
			"action": "4.4.2",
			"card": "5.1.4",
			"contact-timeline": "4.1.3",
			"data-badge": "2.2.2",
			"file": "2.5.3",
			"process-steps": "4.3.3",
			"side-navigation": "4.2.4",
			"sidenav": "2.0.0",
			"step-marker": "3.1.3"
		},
		"tokens": {
			"design-tokens-components": "5.1.0",
			"design-tokens-common": "4.0.0"
		},
		"directory": "scripts/sources/denhaag"
	},
	"fontFamily": {
		"token": "--nldesign-font-family",
		"from": "Den Haag names TheSans, which this app does not ship; the set font wins"
	},
	"radiusToken": "--nldesign-border-radius",
	"website": {
		"_comment": "A --nldesign-website-* vocabulary token a set MAY name to refine one Den Haag role on its portal; the role's value from the rules below stays as the fallback (openspec/changes/zuiddrecht-website-type-and-controls).",
		"--denhaag-step-marker-size": {
			"token": "--nldesign-website-step-marker-size",
			"from": "the marker's size; Zuiddrecht draws 36px over Den Haag's 32px"
		},
		"--denhaag-step-marker-checked-background-color": {
			"token": "--nldesign-website-step-done-color",
			"from": "a done step filled in the set's own colour"
		},
		"--denhaag-step-marker-checked-border-color": {
			"token": "--nldesign-website-step-done-color",
			"from": "a done step's ring, the same colour as its fill"
		},
		"--denhaag-step-marker-checked-color": {
			"token": "--nldesign-website-step-done-mark-color",
			"from": "the tick on a filled done step"
		},
		"--denhaag-step-marker-connector-checked-outline-color": {
			"token": "--nldesign-website-step-done-color",
			"from": "the line after a done step"
		},
		"--denhaag-step-marker-current-background-color": {
			"token": "--nldesign-website-step-current-background-color",
			"from": "the current step's fill; Zuiddrecht keeps it white under a red ring"
		},
		"--denhaag-step-marker-current-border-color": {
