			identifier: class.notFound
			count: 2
			path: lib/Service/ThemingService.php

		-
			message: '#^Method OCA\\Thematiq\\Service\\TokenSetConverterService\:\:runRules\(\) never assigns null to &\$manifest so it can be removed from the by\-ref type\.$#'
