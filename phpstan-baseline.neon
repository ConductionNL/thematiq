		-
			message: '#^Parameter &\$report by\-ref type of method OCA\\Thematiq\\Service\\TokenSetConverterService\:\:runRules\(\) expects array\<int, array\{source\: string, target\: string, action\: string, reason\: string\|null, value\: string\|null, original\?\: string\}\>, non\-empty\-array\<int, array\{source\: string, target\: string, action\: string, reason\: mixed, value\: string\|null, original\?\: string\}\> given\.$#'
			identifier: parameterByRef.type
			count: 1
