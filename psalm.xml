<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    findUnusedVariablesAndParams="true"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="vendor/nextcloud/ocp/OCP/Capabilities/ICapability.php" preloadClasses="true" />
        <!-- OpenRegister's federated-config contract (soft runtime dependency,
             absent during analysis). Resolves the IShareableConfigType
             interface and the RegisterShareableConfigTypesEvent generic in
             lib/Service/Config/ + lib/Listener/. Never autoloaded at runtime. -->
        <file name="stubs/openregister-config.php" />
        <!-- Nextcloud's legacy global OC_App. It lives in lib/private/ in the
             server, so it is absent from the nextcloud/ocp package the
             analysers see. Required by the ADR-040 autoload prelude in
             lib/AppInfo/Application.php. Never autoloaded at runtime. -->
        <file name="stubs/nextcloud-legacy.php" />
        <!-- Server-private classes this app calls or extends: OCA\Theming
             (lib/Service/ThemingService.php and friends) and
             OC\Mail\EMailTemplate (lib/Mail/NLDesignEMailTemplate.php's
             parent). Stubs make psalm check the calls instead of
             suppressing UndefinedClass. Never autoloaded at runtime. -->
        <file name="stubs/nextcloud-theming.php" />
        <file name="stubs/nextcloud-mail.php" />
    </stubs>
    <issueHandlers>
        <!-- Burned down on 2026-10-02 from 37 blanket handlers and a 70-class
             UndefinedClass list to the five below. Every other issue type is
             live: fix a new finding, do not add a handler for it.

             All five are the same false positive. Psalm sees only lib/, so
             it cannot see the callers Nextcloud reaches by reflection
             (routes.php to controller methods, the DI container to services,
             info.xml to repair steps, commands and jobs, events to
             listeners) or the unit tests that read a return value. Measured
             with every handler removed: 85 PossiblyUnusedMethod, 36
             UnusedClass, 2 PossiblyUnusedParam, 2 PossiblyUnusedReturnValue,
             and 2 private members of NlDesignThemeShareableConfigType, a
             class only OpenRegister instantiates. -->
        <PossiblyUnusedMethod errorLevel="suppress"/>
        <UnusedClass errorLevel="suppress"/>
        <PossiblyUnusedParam errorLevel="suppress"/>
        <PossiblyUnusedReturnValue errorLevel="suppress"/>
        <UnusedMethod>
            <errorLevel type="suppress">
                <file name="lib/Service/Config/NlDesignThemeShareableConfigType.php"/>
            </errorLevel>
        </UnusedMethod>
        <UnusedProperty>
            <errorLevel type="suppress">
                <file name="lib/Service/Config/NlDesignThemeShareableConfigType.php"/>
            </errorLevel>
        </UnusedProperty>
    </issueHandlers>
    <extraFiles>
        <directory name="vendor/nextcloud/ocp" />
    </extraFiles>
</psalm>
