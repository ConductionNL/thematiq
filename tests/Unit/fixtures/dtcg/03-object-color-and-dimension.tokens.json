{
  "color": {
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0824, 0.2588, 0.4510],
        "alpha": 1,
        "hex": "#154273"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "cmyk",
        "components": [0.1, 0.3, 0.6],
        "alpha": 1
      }
    }
  },
  "dimension": {
    "border-radius": {
      "$type": "dimension",
      "$value": { "value": 8, "unit": "px" }
    }
  }
}
