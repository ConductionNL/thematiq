	{
		"id": "frankendesk",
		"name": "La Frankendesk",
		"description": "Conduction's own branded riff on the lasuite bundle. EXTENDS `lasuite`: the renderer loads the parent set first and this one after, so this file is the DELTA — the logo and anything Conduction deliberately changes — instead of a copy that drifts. Same violet Cunningham design tokens (MIT), self-hosted Inter, brand blue-violet #4844AD, with the original \"La Frankendesk\" mark as logo.",
		"design_system": "lasuite",
		"theming": {
			"primary_color": "#4844AD",
			"background_color": "#FFFFFF",
			"logo": "img/logos/frankendesk.svg"
		},
		"extends": "lasuite"
	},
	{
		"id": "cunningham",
		"name": "Cunningham (blue base)",
		"description": "The published Cunningham design system (MIT, @openfun/cunningham-tokens) as distributed — blue base (brand-650 #1A509F, the same scale step the shared bridge/element-overrides derive --color-primary from for lasuite's violet #4844AD), self-hosted Inter. Secondary/optional sibling of lasuite: same generated token base, without the deployed violet La Suite brand override. No logo bundled.",
		"design_system": "cunningham",
		"theming": {
			"primary_color": "#1A509F",
			"background_color": "#E1E2E5"
		}
	},
