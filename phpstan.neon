# NL Design — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either the
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # No baseline: it reached zero on 2026-10-02 (16 entries were server-private
    # OCA\Theming classes, now declared in stubs/nextcloud-theming.php; the
    # other 3 were fixed in code). Fix a new finding, do not baseline it.

parameters:
    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # excludePaths, scanDirectories and every fleet-wide ignore.
    excludePaths:
        # HealthController extends the OpenRegister AppHost engine's
        # GenericHealthController (ADR-040) — a SOFT/optional dependency autoloaded
        # only on route dispatch, never at bootstrap, so OpenRegister is genuinely
        # absent during static analysis. PHPStan's "extends unknown class" / "calls
        # parent:: but does not extend any class" errors are structural
        # (class-hierarchy) errors that cannot be suppressed via ignoreErrors —
        # excludePaths is the tool's own recommended fix. Mirrors the file's existing
        # @psalm-suppress UndefinedClass rationale.
        - lib/Controller/HealthController.php

    scanDirectories:
        # Declaration-only stubs for OpenRegister's federated-config contract
        # (IShareableConfigType + RegisterShareableConfigTypesEvent), a soft
        # runtime dependency absent during analysis. Lets phpstan resolve the
        # interface NlDesignThemeShareableConfigType implements and the event
        # ShareableConfigTypeListener dispatches on — without excludePaths.
        # See stubs/openregister-config.php. The same directory carries the
        # server-private classes this app touches: OCA\Theming (theming writes)
        # and OC\Mail\EMailTemplate (the mail template's parent), so
        # NLDesignEMailTemplate is analysed instead of excluded. Never
        # autoloaded at runtime.
        - stubs
