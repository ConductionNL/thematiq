        "/my-groups/house-style": {
            "get": {
                "operationId": "my-groups-index",
                "summary": "The delegated groups of the signed-in user",
                "description": "The delegated groups of the signed-in user. Needs an administrator, or a user the matching admin setting is delegated to.",
                "tags": [
                    "my-groups"
                ],
                "responses": {
                    "200": {
                        "description": "The request succeeded.",
                        "headers": {
