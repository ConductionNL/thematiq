        "/my-groups/{group}/house-style": {
            "post": {
                "operationId": "my-groups-update",
                "summary": "Set the house style of a delegated group",
                "description": "Set the house style of a delegated group. Needs an administrator, or a user the matching admin setting is delegated to.",
                "tags": [
                    "my-groups"
                ],
                "parameters": [
                    {
                        "name": "group",
                        "in": "path",
                        "required": true,
                        "description": "The group id.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "tokenSet": {
                                        "type": "string",
                                        "description": "The chosen set."
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The request succeeded.",
                        "headers": {
                            "API-Version": {
                                "$ref": "#/components/headers/API-Version"
                            }
