{
    "openapi": "3.0.3",
    "info": {
        "title": "Thematiq",
        "version": "1.2.29-unstable.20261114023933",
        "description": "The JSON API of Thematiq, the theming app for Nextcloud: design token sets and their deprecations, app brands, document styles, workspace icons, contrast checks and the settings behind them.\n\nEvery path is served under `/api/v1/`, the version this document describes. The unversioned `/api/` paths keep working, are deprecated, and name their `/api/v1/` successor in a `Link` header next to a `Deprecation` header. Errors are RFC 9457 problem details (`application/problem+json`), and every response carries an `API-Version` header. Paths that implement an external standard keep the formats of that standard and are not described here.",
        "contact": {
            "name": "Conduction B.V.",
            "email": "info@conduction.nl",
            "url": "https://conduction.nl"
        },
        "license": {
            "name": "EUPL-1.2",
            "url": "https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12"
        }
    },
    "servers": [
        {
            "url": "https://{host}/index.php/apps/thematiq/api/v1",
            "description": "The Thematiq API, version 1, on a Nextcloud instance.",
            "variables": {
                "host": {
                    "default": "localhost",
                    "description": "The host name of the Nextcloud instance."
                }
            }
        }
    ],
    "security": [
        {
            "basic_auth": []
        },
        {
            "bearer_auth": []
        }
    ],
    "tags": [
        {
            "name": "app-brand",
            "description": "The Brand per app block (`/settings/app-brands`, admin) and the logos (`/api/app-brands/{appId}/logo/{size}`, signed-in users, since branded pages are signed-in pages)."
        },
        {
            "name": "assistant-mark",
            "description": "`GET /api/assistant-mark` for signed-in users (the contract with the assistant panel in nextcloud-vue), `GET` and `POST /settings/assistant-mark` for administrators."
        },
        {
            "name": "catalog",
            "description": "Non-admin, read-only token-set catalogue endpoint for a leaf app's own picker (e.g. a builder tool inside another Conduction app)."
        },
        {
            "name": "contrast",
            "description": "Shared WCAG contrast-evaluation endpoint for a leaf app's own picker or free-hand color authoring feature."
        },
        {
            "name": "document-style",
            "description": "Signed-in users read the profile (`GET /api/document-style`) and its assets; administrators manage the Documents block under `/settings/document-style`."
        },
        {
            "name": "my-groups",
            "description": "`GET /api/my-groups/house-style` lists the delegated groups the signed-in user is subadmin of; `POST /api/my-groups/{group}/house-style` sets one. Both need the delegated setting {@see GroupHouseStyle} (an administrator, or a member of a group the administrator granted it to); the write also checks, on every call, that the user is subadmin of the named group and that the set is on its allowed list, answering 403 otherwise."
        },
        {
            "name": "open-api",
            "description": "The OpenAPI document that describes this API."
        },
        {
            "name": "shell-token",
            "description": "GET /api/shell-tokens: the active token set as eighteen shell roles and a logo, for a product that wears the same shell as this Nextcloud (the OpenProject plugin is the first)."
        },
        {
            "name": "token-reference",
            "description": "The token reference of any available token set, custom sets included, for any signed-in user. `#[NoAdminRequired]`, never `#[PublicPage]`: a custom set is the organisation's own and may not be published yet. A controller of its own next to CatalogController, whose constructor other code and tests pin."
        },
        {
            "name": "workspace-icon",
            "description": "The two workspace images."
        }
    ],
    "paths": {
        "/app-brands/{appId}/logo/{size}": {
            "get": {
                "operationId": "app-brand-logo",
                "summary": "A brand logo, for signed-in users",
                "description": "A brand logo, for signed-in users. Needs a signed-in Nextcloud user.",
                "tags": [
                    "app-brand"
                ],
                "parameters": [
                    {
                        "name": "appId",
                        "in": "path",
                        "required": true,
                        "description": "The app id.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "size",
                        "in": "path",
                        "required": true,
                        "description": "`large` or `small`.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The request succeeded.",
                        "headers": {
                            "API-Version": {
                                "$ref": "#/components/headers/API-Version"
                            }
                        },
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Problem401"
                    },
                    "404": {
                        "$ref": "#/components/responses/Problem404"
                    }
                }
            }
        },
        "/assistant-mark": {
            "get": {
                "operationId": "assistant-mark-show",
                "summary": "The mark for the signed-in user's assistant panel. No session, no answer: the route has no public-page attribute, so Nextcloud refuses anonymous calls",
                "description": "The mark for the signed-in user's assistant panel. No session, no answer: the route has no public-page attribute, so Nextcloud refuses anonymous calls. Needs a signed-in Nextcloud user.",
                "tags": [
                    "assistant-mark"
                ],
                "responses": {
                    "200": {
                        "description": "The request succeeded.",
                        "headers": {
                            "API-Version": {
                                "$ref": "#/components/headers/API-Version"
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Problem401"
                    }
                }
            }
        },
        "/contrast/evaluate": {
            "post": {
                "operationId": "contrast-evaluate",
                "summary": "POST /api/contrast/evaluate — evaluate arbitrary candidate colors against a caller-supplied background",
                "description": "POST /api/contrast/evaluate — evaluate arbitrary candidate colors against a caller-supplied background. Accepts `{ candidates: [{ name, value, role: \"text\"|\"ui\" }], background: string }` and returns `{ results: [{ name, ratio, threshold, level, pass, unevaluated? }] }`. A malformed request (missing/invalid `candidates` or `background`) returns 400, never a silent 200 with fabricated results. Public: it needs no login.",
                "tags": [
                    "contrast"
                ],
                "security": [],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The request succeeded.",
                        "headers": {
                            "API-Version": {
                                "$ref": "#/components/headers/API-Version"
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/Problem400"
                    }
                }
            }
        },
        "/document-style": {
            "get": {
                "operationId": "document-style-show",
                "summary": "The profile for the signed-in user. Without a session Nextcloud refuses the request",
