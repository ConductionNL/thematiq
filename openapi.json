        "/workspace-icons/{kind}": {
            "get": {
                "operationId": "workspace-icon-show",
                "summary": "Serve an image to anyone: a phone fetches the touch icon without a session, and the login page draws the header too. Instance-wide brand images,...",
                "description": "Serve an image to anyone: a phone fetches the touch icon without a session, and the login page draws the header too. Instance-wide brand images, the same for every visitor. Public: it needs no login.",
                "tags": [
                    "workspace-icon"
