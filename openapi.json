            "get": {
                "operationId": "token-reference-show",
                "summary": "GET /api/token-sets/{id}/reference?format=md|html[&download=1]",
                "description": "GET /api/token-sets/{id}/reference?format=md|html[&download=1]. Needs a signed-in Nextcloud user.",
                "tags": [
                    "token-reference"
                ],
                "parameters": [
                    {
