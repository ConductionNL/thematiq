                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Problem401"
                    },
                    "403": {
                        "$ref": "#/components/responses/Problem403"
                    },
                    "422": {
                        "$ref": "#/components/responses/Problem422"
                    }
                }
            }
        },
        "/openapi.json": {
            "get": {
                "operationId": "open-api-show",
                "summary": "The OpenAPI document of this API",
                "description": "Returns this document, with `info.version` set to the installed version. It needs no login and can be read from any origin.",
                "tags": [
                    "open-api"
                ],
                "security": [],
                "responses": {
                    "200": {
                        "description": "The OpenAPI document.",
                        "headers": {
                            "API-Version": {
